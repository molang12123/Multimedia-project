; Engine configuration file.
; Existing B/C/D prototype files and original view settings are untouched.
config_version=5

[application]

config/name="SilverRhythm"
run/main_scene="res://scenes/core/bootstrap.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/core/game_state.gd"
AudioManager="*res://scripts/mocks/mock_audio_manager.gd"
GameManager="*res://scripts/core/game_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[global]

MainMenu.tscn=false

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
